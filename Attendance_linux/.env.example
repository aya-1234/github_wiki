# ============================================================
# Attendance Linux (attendance-login) 環境設定ファイル
# このファイルを .env にコピーして利用する:
#   cp .env.example .env
# 各値は必ず実環境に合わせて修正すること。
# 詳細は docs/linux_setup_guide.md を参照。
# ============================================================

# 確定済み起点URL。二重エンコード部分を変更しないこと。
ATTENDANCE_TOP_URL=https://meitecgroup.my.salesforce.com/?ec=302&startURL=%2Fvisualforce%2Fsession%3Furl%3Dhttps%253A%252F%252Fmeitecgroup.lightning.force.com%252Flightning%252Fn%252Ftex__TimeAttendance

# 自動化専用のChromeプロファイルを指定する（Linux パス）。
# 初回ログインでこのディレクトリにセッションが保存される。
CHROME_USER_DATA_DIR=~/attendance-chrome
CHROME_PROFILE_DIRECTORY=Default

# Microsoftアカウント選択画面に表示される対象アカウント。
TARGET_ACCOUNT=user@example.com

# 通知先（Webhook）。空の場合は通知を無効化する。
WEBHOOK_URL=

# ログインのタイムアウト（秒）。1～300。
LOGIN_TIMEOUT_SECONDS=60
# ページ読み込みのタイムアウト（秒）。1～300。
PAGE_LOAD_TIMEOUT_SECONDS=30
# Webhook 送信のタイムアウト（秒）。1～60。
WEBHOOK_TIMEOUT_SECONDS=5

# Salesforceへのページ遷移・保存・申請操作の最小間隔（秒）。0～300。
# サーバー負荷軽減のため、通常は既定の5秒以上を推奨する。
SERVER_REQUEST_DELAY_SECONDS=5

# ヘッドレス運用フラグ。cron からの自動実行では true にする。
# 初回セッション確立時のみ GUI で false にして実行する。
HEADLESS=true
# エラー時にブラウザを開いたままにするか。
KEEP_BROWSER_OPEN_ON_ERROR=false
# ログレベル: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# ログファイルの場所（Linux パス）。
LOG_FILE=~/attendance-chrome/attendance-login.log
# ログの保持日数。1～365。
LOG_RETENTION_DAYS=30

# 当日勤務情報。HH:MM は必ず2桁で指定する。
WORK_START_TIME=09:00
WORK_END_TIME=17:45
# 勤務場所（出社 / 在宅 など）。
WORK_PLACE=出社
# 業務内容。255文字以内。
BUSINESS_CONTENT=開発業務

# 工数ファイル入力の有効化。
WORKLOAD_ENABLED=false
# 工数入力用 JSON ファイルの場所（Linux パス）。
# WORKLOAD_ENABLED=true の場合は必須。
WORKLOAD_FILE=~/attendance-workload.json
# 工数情報の上書きを許可するか。
WORKLOAD_ALLOW_OVERWRITE=false
# 工数対象日の許容誤差（分）。0～60。
WORKLOAD_TOLERANCE_MINUTES=0

# 勤務表申請の有効化。
APPLICATION_ENABLED=false
# 申請時に確認を求めるか（自動実行では false にすると確認なし）。
APPLICATION_CONFIRM_ONLY=true
# 申請を自動送信するか（APPLICATION_ENABLED=true かつ
# APPLICATION_CONFIRM_ONLY=false が必要）。
APPLICATION_AUTO_SUBMIT=false

# 勤務時間申請（daily request）の有効化。
DAILY_REQUEST_ENABLED=false
# 勤務時間入力のタイムアウト（秒）。1～120。
WORK_INPUT_TIMEOUT_SECONDS=10
